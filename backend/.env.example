# ── Django ────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=unsafe-development-key-replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED in production — must differ from DJANGO_SECRET_KEY.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production

# Token lifetimes (seconds)
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=2592000

# ── Vault Encryption ──────────────────────────────────────────────────────────
# AES-256-GCM key — must be exactly 32 bytes, base64url-encoded.
# Generate: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# NEVER commit a real key. Store in a secrets manager in production.
ENCRYPTION_KEY=

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Backend-only. Never expose to frontend or users.
# For local dev: add your current IP to Atlas Network Access allowlist.
# For production: add only the production backend/server IP(s).
MONGODB_URI=
MONGODB_DATABASE=keyvaultai

# ── Redis ─────────────────────────────────────────────────────────────────────
# Backend-only (rate limiting, Celery broker/backend).
# Production: use Upstash Redis TLS URL (rediss://...)
REDIS_URL=redis://localhost:6379/0

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev: leave empty — development.py allows localhost:3000 automatically.
CORS_ALLOWED_ORIGINS=

# ── Django settings module ────────────────────────────────────────────────────
# Use 'config.settings.development' locally, 'config.settings.production' in prod.
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Outbound email (SMTP-compatible Django email backend) ────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
