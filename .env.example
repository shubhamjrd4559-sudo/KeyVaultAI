DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

MONGODB_URI=
MONGODB_DATABASE=keyvaultai

REDIS_URL=redis://redis:6379/0

# JWT — configure a SEPARATE secret in production (do not reuse DJANGO_SECRET_KEY)
JWT_SECRET_KEY=change-me-to-a-different-long-random-secret
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=2592000

# AES-256-GCM encryption key — reserved for Milestone 3 (Secure Password Vault)
ENCRYPTION_KEY=

# NVIDIA NIM — reserved for Milestone 7
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP-compatible email delivery. Keep credentials backend-only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
